# Server Config
PORT=5000
CORS_ORIGINS=https://iiitdm-lab.in,https://your-vercel-app-name.vercel.app

# Database Config (Use MongoDB Atlas for free cloud DB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vibes_lab

# Authentication (Change this to a long random string)
JWT_SECRET=super_secret_key_for_vibes_lab_production

# AI / Chatbot Config
GOOGLE_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Email Settings (Optional, for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
